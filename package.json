{
  "name": "drq-complete",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:runner:win": "cargo build --release --manifest-path src-win/Cargo.toml",
    "copy:runner:win": "node -e \"const fs=require('fs'); fs.mkdirSync('src-tauri/resources', {recursive:true}); fs.copyFileSync('src-win/target/release/src-win.exe', 'src-tauri/resources/src-win.exe')\"",
    "build:runner:linux": "cargo build --release --manifest-path src-linux/Cargo.toml",
    "copy:runner:linux": "node -e \"const fs=require('fs'); fs.mkdirSync('src-tauri/resources', {recursive:true}); fs.copyFileSync('src-linux/target/release/src-linux', 'src-tauri/resources/src-linux')\"",
    "build:runner:darwin": "cargo build --release --manifest-path src-darwin/Cargo.toml",
    "copy:runner:darwin": "node -e \"const fs=require('fs'); fs.mkdirSync('src-tauri/resources', {recursive:true}); fs.copyFileSync('src-darwin/target/release/src-darwin', 'src-tauri/resources/src-darwin')\"",
    "sync:runner": "node scripts/sync-runner.mjs",
    "tauri:dev": "tauri dev"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-http": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@vueuse/core": "^13.1.0",
    "@vueuse/integrations": "^13.9.0",
    "fuse.js": "^7.1.0",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.1.5",
    "tailwindcss": "^4.1.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/lodash-es": "^4.17.12",
    "@vitejs/plugin-vue": "^5.2.1",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@8.15.3+sha256.fc4a49bd609550a41e14d20efbce802a4b892aa4cac877322de2f0924f122991"
}